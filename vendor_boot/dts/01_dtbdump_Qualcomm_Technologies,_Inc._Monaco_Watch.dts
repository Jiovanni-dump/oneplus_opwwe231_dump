						type = "passive";
					};
				};

				cooling-maps {

					gpu-cdev {
						trip = <0x42>;
						cooling-device = <0x3f 0xffffffff 0xffffffff>;
					};

					gpu-cx-cdev0 {
						trip = <0x43>;
						cooling-device = <0x3f 0x03 0xffffffff>;
					};

					gpu-cx-cdev1 {
						trip = <0x43>;
						cooling-device = <0x40 0x03 0x03>;
					};
				};
			};

			camera {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-sensors = <0x37 0x07>;

				trips {

					thermal-engine-config {
						temperature = <0x1e848>;
						hysteresis = <0x3e8>;
						type = "passive";
					};

					reset-mon-cfg {
						temperature = <0x1c138>;
						hysteresis = <0x1388>;
						type = "passive";
					};
				};
			};

			zeroc {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
