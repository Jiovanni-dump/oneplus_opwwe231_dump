					compatible = "qcom,bcl-v5";
					reg = <0x4700 0x100>;
					interrupts = <0x00 0x47 0x00 0x00 0x00 0x47 0x01 0x00 0x00 0x47 0x02 0x00>;
					interrupt-names = "bcl-lvl0\0bcl-lvl1\0bcl-lvl2";
