								function = "normal";
								qcom,drive-strength = <0x03>;
								bias-disable;
								output-high;
							};
						};

						sde_dsi_suspend {
							phandle = <0x15f>;

							pinconf {
								pins = "gpio1";
								function = "normal";
								qcom,drive-strength = <0x01>;
								bias-pull-down;
								output-low;
							};
						};
					};

					nfc_clk {

						nfc_clk_default {
							pins = "gpio4";
							function = "normal";
							input-enable;
							power-source = <0x01>;
							phandle = <0x78>;
						};
					};
				};

				rtc@6400 {
					compatible = "qcom,pm5100-rtc";
					reg = <0x6400 0x6500>;
					reg-names = "rtc\0alarm";
					interrupts = <0x00 0x65 0x01 0x01>;
					phandle = <0x160>;
